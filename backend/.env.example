# Placeholder — PGlite ignores this at runtime but Prisma CLI needs it for introspection
DATABASE_URL=postgresql://localhost:5432/saga_vistoria

# Directory where PGlite stores its data
DB_DIR=./data/db

# Directory for backups
BACKUP_DIR=./backups

# Directory for uploaded photos
UPLOAD_DIR=./uploads

# JWT secret — change in production
JWT_SECRET=change_me_in_production_please

# Server port
PORT=3001
